{
    "//1": "调试启动配置: 调试单文件 / 后端 FastAPI(UBUNTU & WIN) / 前端 Vite",
    "//2": "F5 默认启动第一个配置; 选 \"前后端一起 (全栈)\" 可一键启动全部服务",
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug single file (PYTHONPATH=src)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}/code/backend/server_py",
            "python": "${workspaceFolder}/code/backend/server_py/.venv/bin/python",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/code/backend/server_py/src"
            },
            "justMyCode": false,
            "console": "integratedTerminal"
        },
        {
            "name": "▶UBUNTU Backend: app.py (server_py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/code/backend/server_py/src/app.py",
            "cwd": "${workspaceFolder}/code/backend/server_py",
            "python": "${workspaceFolder}/code/backend/server_py/.venv/bin/python",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/code/backend/server_py/src"
            },
            "justMyCode": false,
            "console": "integratedTerminal"
        },
        {
            "name": "▶ WIN Backend: app.py (server_py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/code/backend/server_py/src/app.py",
            "cwd": "${workspaceFolder}/code/backend/server_py",
            "python": "${workspaceFolder}/code/backend/server_py/.venv/Scripts/python.exe",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/code/backend/server_py/src"
            },
            "justMyCode": false,
            "console": "integratedTerminal"
        },
        {
            "name": "▶ Frontend: pnpm run dev (vue3)",
            "type": "node-terminal",
            "request": "launch",
            "command": "pnpm run dev",
            "cwd": "${workspaceFolder}/code/frontend/vue3",
            "env": {
                "PATH": "/home/here/.local/share/fnm/aliases/default/bin:${env:PATH}"
            }
        },
        {
            "name": "▶ Mobile Client: flutter (自动选择设备)",
            "type": "dart",
            "request": "launch",
            "program": "${workspaceFolder}/code/frontend/flutter/lib/main.dart",
            "cwd": "${workspaceFolder}/code/frontend/flutter",
            "env": {
                "ANDROID_HOME": "${env:HOME}/android-sdk"
            }
        },
        {
            "name": "▶ WIN Mobile Client: flutter (Windows 桌面窗口)",
            "type": "dart",
            "request": "launch",
            "program": "${workspaceFolder}/code/frontend/flutter/lib/main.dart",
            "cwd": "${workspaceFolder}/code/frontend/flutter",
            "args": ["-d", "windows"]
        },
        {
            "name": "▶ Mobile Client: flutter (Linux 桌面窗口)",
            "type": "dart",
            "request": "launch",
            "program": "${workspaceFolder}/code/frontend/flutter/lib/main.dart",
            "cwd": "${workspaceFolder}/code/frontend/flutter",
            "args": ["-d", "linux"],
            "env": {
                "ANDROID_HOME": "${env:HOME}/android-sdk"
            }
        }
    ],
    "compounds": [
        {
            "name": "前后端一起win (全栈)",
            "configurations": [
                "▶ WIN Backend: app.py (server_py)",
                "▶ Frontend: pnpm run dev (vue3)"
            ],
            "stopAll": true
        },
        {
            "name": "前后端一起ub (全栈)",
            "configurations": [
                "▶UBUNTU Backend: app.py (server_py)",
                "▶ Frontend: pnpm run dev (vue3)"
            ],
            "stopAll": true
        },
        {
            "name": "后端 + 手机客户端 (ub 全栈)",
            "configurations": [
                "▶UBUNTU Backend: app.py (server_py)",
                "▶ Mobile Client: flutter (自动选择设备)"
            ],
            "stopAll": true
        },
        {
            "name": "后端 + 手机客户端 (win 全栈)",
            "configurations": [
                "▶ WIN Backend: app.py (server_py)",
                "▶ WIN Mobile Client: flutter (Windows 桌面窗口)"
            ],
            "stopAll": true
        }
    ]
}
