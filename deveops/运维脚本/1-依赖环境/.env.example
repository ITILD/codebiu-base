# ==============================================================================
# 依赖环境配置（复制为 .env 后生效；./ctl.sh 首次会自动复制）
# 按主机拆分，改 COMPOSE_PROFILES 决定本机跑哪一组：
#   47.94.107.62    COMPOSE_PROFILES=db        （PostgreSQL + Redis）
#   112.126.84.138  COMPOSE_PROFILES=storage   （RustFS + Milvus + nginx + certbot）
# ==============================================================================
COMPOSE_PROJECT_NAME=codebiu-deps
COMPOSE_PROFILES=db

# ---------------- PostgreSQL ----------------
PG_PORT=20001
POSTGRES_DB=codebiu_base
POSTGRES_USER=here
POSTGRES_PASSWORD=here940901

# ---------------- Redis ----------------
REDIS_PORT=20002
REDIS_PASSWORD=here940901940901
# 限制 Redis 内存；noeviction 保证任务消息不会被淘汰（满了会报错而不是丢任务）
REDIS_MAXMEMORY=256mb

# ---------------- Milvus ----------------
MILVUS_PORT=20005
MILVUS_METRICS_PORT=20008
# 向量数据复用 RustFS（bucket 用 Milvus 默认的 a-bucket，与线上一致）
# Milvus 与 RustFS 同机时用服务名；Milvus 独立部署时改成 deps 内网 IP:20006
MILVUS_S3_ENDPOINT=rustfs:9000
MILVUS_S3_SSL=false
MILVUS_S3_REGION=us-east-1
# Go 堆上限（小内存机器按需调小）
MILVUS_GOMEMLIMIT=256MiB
ETCD_GOMEMLIMIT=128MiB

# ---------------- RustFS（S3 兼容对象存储） ----------------
RUSTFS_PORT=20006
RUSTFS_CONSOLE_PORT=20007
# 仅本机可直连；公网请走下面的 nginx HTTPS
RUSTFS_BIND_IP=127.0.0.1
# 与 47 主机现有 RustFS 保持一致，迁移旧数据时不要改
RUSTFS_ACCESS_KEY=minioadmin
RUSTFS_SECRET_KEY=minioadmin

# ---------------- 文件服务 HTTPS（nginx + certbot） ----------------
# 已备案域名（建议用主域名的子域名，如 fs.example.com 指向本机）；留空则需先填再 ./ctl.sh cert
FILE_DOMAIN=
# Let's Encrypt 通知邮箱
CERT_EMAIL=
# 对外端口：签发证书要求公网 80 可达本机，默认直接用 80/443
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
