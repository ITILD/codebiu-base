# ==============================================================================
# server_1（112 任务队列机）依赖配置：RustFS + Milvus + nginx + certbot
# 使用：cp server_1/.env.example server_1/.env 后按需修改
#      ./ctl.sh --role server_1 up
# ==============================================================================
COMPOSE_PROJECT_NAME=codebiu-deps-1
COMPOSE_PROFILES=storage

# ---------------- Milvus ----------------
MILVUS_PORT=20005
MILVUS_METRICS_PORT=20008
# 向量数据复用同机 RustFS（bucket 用 Milvus 默认的 a-bucket）
MILVUS_S3_ENDPOINT=rustfs:9000
MILVUS_S3_SSL=false
MILVUS_S3_REGION=us-east-1
MILVUS_GOMEMLIMIT=256MiB
ETCD_GOMEMLIMIT=128MiB

# ---------------- RustFS（S3 兼容对象存储） ----------------
RUSTFS_PORT=20006
RUSTFS_CONSOLE_PORT=20007
# 仅本机可直连；公网请走下面的 nginx HTTPS
RUSTFS_BIND_IP=127.0.0.1
RUSTFS_ACCESS_KEY=minioadmin
RUSTFS_SECRET_KEY=change-me

# ---------------- 文件服务 HTTPS（nginx + certbot） ----------------
FILE_DOMAIN=
CERT_EMAIL=
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
