# ==============================================================================
# server_0（47 主服务机）依赖配置：PostgreSQL + Redis
# 使用：cp server_0/.env.example server_0/.env 后按需修改
#      ./ctl.sh --role server_0 up
# ==============================================================================
COMPOSE_PROJECT_NAME=codebiu-deps-0
COMPOSE_PROFILES=db

# ---------------- PostgreSQL ----------------
PG_PORT=20001
POSTGRES_DB=codebiu_base
POSTGRES_USER=here
POSTGRES_PASSWORD=change-me

# ---------------- Redis ----------------
REDIS_PORT=20002
REDIS_PASSWORD=change-me
# 限制 Redis 内存；noeviction 保证任务消息不会被淘汰（满了会报错而不是丢任务）
REDIS_MAXMEMORY=256mb
