# ==============================================================================
# 部署配置 —— 每项都可用环境变量临时覆盖: DEPLOY_DIR=/x ./build_all.sh
# 上面三行是常改项; 分隔线以下保持默认即可
# ==============================================================================

# 部署根目录(外挂代码/数据/compose 文件都放这)
DEPLOY_DIR="${DEPLOY_DIR:-/home/hrzn/D/a_apps/codebiu-base}"

# 对外端口
NGINX_PORT="${NGINX_PORT:-3002}"     # 前端入口 http://localhost:3002
SERVER_PORT="${SERVER_PORT:-3001}"   # 后端 API http://localhost:3001

# ------------------------------------------------------------------------------

# 容器名前缀(容器名如 base-nginx / base-server)
COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-base}"

# 本地中间件开关: 默认 0 = 不起本地容器, PG/Redis 连远程(地址在 config.dev.yaml)
ENABLE_PG="${ENABLE_PG:-0}"
ENABLE_REDIS="${ENABLE_REDIS:-0}"
# ↓ 仅本地中间件启用时, 给宿主机工具(DBeaver 等)连容器用的端口
PG_PORT="${PG_PORT:-15432}"
REDIS_PORT="${REDIS_PORT:-6379}"
# ↓ 仅 ENABLE_PG=1 时有效; 密码只首次写入部署目录 .env, 之后改那边的
POSTGRES_DB="${POSTGRES_DB:-codebiu}"
POSTGRES_USER="${POSTGRES_USER:-codebiu}"
POSTGRES_PASSWORD="${POSTGRES_PASSWORD:-codebiu123}"

# 后端镜像 tag: 留空 = 自动取 pyproject.toml 的 name:version
SERVER_IMAGE="${SERVER_IMAGE:-}"

# 前端发布: 备份 = 旧 dist 自动存为 index_时间戳(回滚用) / 覆盖
DIST_MODE="${DIST_MODE:-备份}"

# 同步代码到部署目录时, 是否删除源码里已不存在的文件(1=严格一致)
SYNC_DELETE="${SYNC_DELETE:-0}"
