# ==============================================================================
# server_0（47 主服务机）部署配置
# 每项都可用同名环境变量临时覆盖（publish.sh 会传入）
# ==============================================================================

# 部署目录（构建产物、外挂代码、compose 文件都放这里）
DEPLOY_DIR="${DEPLOY_DIR:-/home/hrzn/D/a_apps/server_0/server}"

# 对外端口
NGINX_PORT="${NGINX_PORT:-3002}"     # 前端 HTTP 入口
SERVER_PORT="${SERVER_PORT:-3001}"   # 后端 API

# ---------------- HTTPS（可选） ----------------
# 1=使用 nginx.https.conf（HTTP 自动跳转 HTTPS，需先放好证书）
ENABLE_HTTPS="${ENABLE_HTTPS:-0}"
# 证书域名；留空则不启用 certbot，也不会替换 server_name
DOMAIN="${DOMAIN:-}"
# Let's Encrypt 通知邮箱（./ctl.sh cert 首次签到时必填）
CERT_EMAIL="${CERT_EMAIL:-}"
# 宿主 HTTPS 端口
NGINX_HTTPS_PORT="${NGINX_HTTPS_PORT:-443}"

# 容器名前缀
COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-codebiu-server}"

# 后端镜像 tag：留空 = 自动取 pyproject.toml 的 name:version
SERVER_IMAGE="${SERVER_IMAGE:-}"

# 同步代码到部署目录时删除源码里已不存在的文件
SYNC_DELETE="${SYNC_DELETE:-1}"
