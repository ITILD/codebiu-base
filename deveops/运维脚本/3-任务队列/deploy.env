# ==============================================================================
# 任务队列部署配置（每项都可用同名环境变量临时覆盖）
# ==============================================================================

# 部署目录
DEPLOY_DIR="${DEPLOY_DIR:-/home/hrzn/D/a_apps/codebiu-base/task}"

# 容器名前缀
COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-codebiu-task}"

# 任务镜像 tag：留空 = 自动取 <pyproject name>-task:<version>
TASK_IMAGE="${TASK_IMAGE:-}"

# worker 规模：副本数 × 单副本并发 = 总并行任务数
TASK_REPLICAS="${TASK_REPLICAS:-2}"
TASK_CONCURRENCY="${TASK_CONCURRENCY:-2}"

# 监听队列（默认同时消费批处理与交互队列）
TASK_QUEUES="${TASK_QUEUES:-task_queue,q_interactive}"
# 执行池：prefork(生产推荐) / threads / solo
TASK_POOL="${TASK_POOL:-prefork}"

# 宿主机探针（主服务远程伸缩 worker 时使用；token 需与主服务登记的一致）
HOST_PROBE_PORT="${HOST_PROBE_PORT:-8700}"
HOST_PROBE_TOKEN="${HOST_PROBE_TOKEN:-change-me}"

# 同步代码时删除源码里已不存在的文件
SYNC_DELETE="${SYNC_DELETE:-1}"
