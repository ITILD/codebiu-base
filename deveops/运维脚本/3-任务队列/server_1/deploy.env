# ==============================================================================
# server_1（112 任务队列机）部署配置
# 每项都可用同名环境变量临时覆盖（publish.sh 会传入）
# ==============================================================================

# 部署目录
DEPLOY_DIR="${DEPLOY_DIR:-/home/hrzn/D/a_apps/server_1/task}"

# 容器名前缀
COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-codebiu-task}"

# 任务镜像 tag：留空 = 自动取 <pyproject name>-task:<version>
TASK_IMAGE="${TASK_IMAGE:-}"

# 运行模式: all=单容器合并 worker+beat+probe(默认, 2G 小机器省内存) / split=三容器拆分
TASK_MODE="${TASK_MODE:-all}"

# worker 规模：副本数 × 单副本并发 = 总并行任务数（all 模式下副本固定 1）
TASK_REPLICAS="${TASK_REPLICAS:-1}"
TASK_CONCURRENCY="${TASK_CONCURRENCY:-2}"

# 监听队列（默认同时消费批处理与交互队列）
TASK_QUEUES="${TASK_QUEUES:-task_queue,q_interactive}"
# 执行池：all(合并)模式推荐 threads(单进程多线程最省内存) / prefork(CPU 密集) / solo
TASK_POOL="${TASK_POOL:-threads}"

# 宿主机探针（主服务远程伸缩 worker 时使用；token 需与主服务登记的一致）
HOST_PROBE_PORT="${HOST_PROBE_PORT:-8700}"
HOST_PROBE_TOKEN="${HOST_PROBE_TOKEN:-change-me}"

# 文件服务域名：容器内解析到宿主机 nginx，避免同机访问公网域名回环不通
FS_DOMAIN="${FS_DOMAIN:-fs.shiyeji.vip}"

# 主服务公网 IP：容器内 host.docker.internal 指向它（Milvus 已迁到 47 主服务机）
MAIN_IP="${MAIN_IP:-}"

# 同步代码时删除源码里已不存在的文件
SYNC_DELETE="${SYNC_DELETE:-1}"
